{
  "info": {
    "name": "PARKIA EMI UALP V4 - API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Salud",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/salud"
      }
    },
    {
      "name": "Autenticación - CAPTCHA",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/autenticacion/captcha"
      }
    },
    {
      "name": "Autenticación - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombreUsuario\":\"estudiante\",\"contrasena\":\"PARKIA2026!Est\",\"captchaToken\":\"PEGAR_TOKEN\",\"captchaRespuesta\":\"RESPUESTA\"}"
        },
        "url": "{{baseUrl}}/autenticacion/login"
      }
    },
    {
      "name": "Estudiante - Mi parqueo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/estudiante/mi-parqueo"
      }
    },
    {
      "name": "Panel - Resumen",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/panel/resumen"
      }
    },
    {
      "name": "Vehículos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/vehiculos"
      }
    },
    {
      "name": "Accesos - Eventos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/accesos/eventos"
      }
    },
    {
      "name": "Parqueos - Zonas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/parqueos/zonas"
      }
    },
    {
      "name": "Ocupación",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/ocupacion/estado"
      }
    },
    {
      "name": "Alertas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/alertas"
      }
    },
    {
      "name": "Historial",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/historial/accesos"
      }
    },
    {
      "name": "Reportes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/reportes/resumen"
      }
    },
    {
      "name": "Auditoría",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auditoria"
      }
    }
  ]
}
